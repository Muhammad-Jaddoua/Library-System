# Copy this file to .env and fill in real values. .env is git-ignored.

# Password for the Postgres superuser and for both services' datasource connections
DB_PASSWORD=change-me

# HS256 signing key shared by auth-service (signs tokens) and api-gateway (verifies them).
# Must be Base64-encoded and at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
